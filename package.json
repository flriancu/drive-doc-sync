{
  "name": "drive-doc-sync",
  "version": "0.7.0",
  "description": "Keeps one JSON document per Google account in that account's own Google Drive: sign-in, storage, merge on conflict, a device copy, sharing and Google's file picker. Browser only, no server.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/google.accounts": "^0.0.18",
    "@types/google.picker": "^0.0.52"
  }
}
